# Persistent host directory mounted at /data inside the container.
INDEX_DATA_PATH=/absolute/path/to/index-inbox/data

# Public HTTPS origin, with no trailing slash.
AUTH_ALLOWED_ORIGINS=https://index.example.com
AUTH_PROVIDER=local
AUTH_COOKIE_SECURE=true

# Generate independent values with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-long-random-value
LOCAL_SETUP_TOKEN=replace-with-a-different-one-time-random-value

AUTH_SESSION_DAYS=30
AUTH_DEVICE_DAYS=90
AUTH_IDLE_DAYS=7

# Set these only when Index Inbox is behind a trusted reverse proxy.
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=

# Optional local transcription settings.
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL=tiny.en
TRANSCRIPTION_LANGUAGE=en
TRANSCRIPTION_THREADS=4

# Optional self-hosted interpretation fallback. Start the Compose "model" profile,
# pull the named model, then enable it from web or Android Settings.
INTERPRETATION_MODEL_URL=
INTERPRETATION_MODEL_NAME=
INTERPRETATION_MODEL_TIMEOUT=8

# Timezone used to interpret spoken reminder times, for example Europe/London.
REMINDER_TIMEZONE=UTC
# How to interpret bare hours after they pass: 24 rolls to tomorrow; 12 tries PM first.
REMINDER_CLOCK_FORMAT=24

# Optional external backup automation.
BACKUP_HOOK_URL=

# Firebase-only settings. They may remain empty for local authentication.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_CREDENTIALS_PATH=
ALLOWED_EMAILS=
REQUIRE_VERIFIED_EMAIL=false
